# ========================================
# FlowSense - Reglas agregadas
# ========================================

# Archivos legacy archivados
._legacy_scratch/

# Videos grandes (no versionar)
video/*.mp4
video/*.avi
video/*.mov

# Modelos YOLO (se descargan automáticamente)
*.pt
!Producto/python/modelos/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Variables de entorno
.env
.env.local
!.env.example

# IDE local
.idea/
.vscode/settings.json


# Claude Code local config
.claude/

# Archivos de prueba local del detector Python
Producto/python/resultado*.csv
Producto/python/test_*.csv
Producto/python/zonas_prueba*.json
Producto/python/zonas_con_bom*.json
Producto/python/test_*.json
zonas_prueba.json
zonas_con_bom.json

# Claude Code - ignorar en cualquier subcarpeta
**/.claude/


Producto/python/tests/fixtures/
gen_test_video.py
test_video.mp4
Producto/python/test.mp4
Producto/python/zonas.json
Producto/python/out.csv
Producto/python/gen_test_fixtures.py

Producto/python/test_videos/
test_overlay.mp4

Producto/python/uploads/